{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build DM3.1_BAT",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Flash DM3.1_BAT (CMSIS-DAP)",
      "type": "shell",
      "command": "make",
      "args": [
        "flash"
      ],
      "problemMatcher": "$gcc",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Erase STM32F407 (CMSIS-DAP)",
      "type": "shell",
      "command": "make",
      "args": [
        "erase"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Clean DM3.1_BAT",
      "type": "shell",
      "command": "make",
      "args": [
        "clean"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
