$(APP_BUILD_DIR)/%.o: %.c Makefile | $(APP_BUILD_DIR)
	mkdir -p $(@D)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(basename $@).lst $< -o $@

$(APP_BUILD_DIR)/%.o: %.s Makefile | $(APP_BUILD_DIR)
	mkdir -p $(@D)
	$(AS) -c $(CFLAGS) $< -o $@

$(APP_BUILD_DIR)/%.o: %.S Makefile | $(APP_BUILD_DIR)
	mkdir -p $(@D)
	$(AS) -c $(CFLAGS) $< -o $@

$(BOOT_BUILD_DIR)/%.o: %.c Makefile | $(BOOT_BUILD_DIR)
	mkdir -p $(@D)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(basename $@).lst $< -o $@

$(BOOT_BUILD_DIR)/%.o: %.s Makefile | $(BOOT_BUILD_DIR)
	mkdir -p $(@D)
	$(AS) -c $(CFLAGS) $< -o $@

$(BOOT_BUILD_DIR)/%.o: %.S Makefile | $(BOOT_BUILD_DIR)
	mkdir -p $(@D)
	$(AS) -c $(CFLAGS) $< -o $@

$(APP_ELF): $(APP_OBJECTS) Makefile
	$(CC) $(APP_OBJECTS) $(APP_LDFLAGS) -o $@
	$(SZ) $@

$(BOOT_ELF): $(BOOT_OBJECTS) Makefile
	$(CC) $(BOOT_OBJECTS) $(BOOT_LDFLAGS) -o $@
	$(SZ) $@

%.hex: %.elf
	$(HEX) $< $@
	
%.bin: %.elf
	$(BIN) $< $@	

$(HOST_APP_BIN): $(APP_BIN)
	mkdir -p $(HOST_FIRMWARE_DIR)
	cp $(APP_BIN) $(HOST_APP_BIN)
	
$(APP_BUILD_DIR) $(BOOT_BUILD_DIR):
	mkdir -p $@		

#######################################
# clean up
#######################################
clean:
	-rm -fR $(BUILD_DIR)

#######################################
# download and debug with CMSIS-DAP
#######################################
flash: app
	$(OPENOCD) $(OPENOCD_ARGS) -c "program $(APP_ELF) verify reset exit"

erase:
	$(OPENOCD) $(OPENOCD_ARGS) -c "init" -c "reset halt" -c "stm32f4x mass_erase 0" -c "reset run" -c "exit"

debug-server:
	$(OPENOCD) $(OPENOCD_ARGS)

debug: all
	$(GDB) -q $(ELF) -ex "target extended-remote | $(OPENOCD) $(OPENOCD_GDB_PIPE_ARGS)" -ex "monitor reset halt" -ex "load"

.PHONY: all app bootloader clean flash erase debug-server debug
  
