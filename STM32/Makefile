OPENOCD ?= openocd
OPENOCD_INTERFACE ?= interface/cmsis-dap.cfg
OPENOCD_TARGET ?= target/stm32f4x.cfg
OPENOCD_TRANSPORT ?= swd
OPENOCD_ADAPTER_SPEED ?= 2000
OPENOCD_ARGS = -f $(OPENOCD_INTERFACE) \
	-c "transport select $(OPENOCD_TRANSPORT)" \
	-f $(OPENOCD_TARGET) \
	-c "adapter speed $(OPENOCD_ADAPTER_SPEED)"
OPENOCD_GDB_PIPE_ARGS = -f $(OPENOCD_INTERFACE) \
	-c 'transport select $(OPENOCD_TRANSPORT)' \
	-f $(OPENOCD_TARGET) \
	-c 'adapter speed $(OPENOCD_ADAPTER_SPEED)' \
	-c 'gdb_port pipe' \
	-c 'log_output $(BUILD_DIR)/openocd-gdb.log'
ifeq ($(GCC_PATH),)
GDB ?= $(PREFIX)gdb
else
GDB ?= $(GCC_PATH)/$(PREFIX)gdb
